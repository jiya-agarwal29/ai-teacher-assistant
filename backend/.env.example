# Secret key used to sign JWT access tokens (auth.py). Generate a long random string for real deployments.
SECRET_KEY=changeme

# Hugging Face API token. Reserved for future use with Hugging Face-hosted models; not currently read by any module.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Minutes before an issued JWT access token expires (auth.py). Defaults to 60 when unset.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins (main.py). Defaults to the local Vite/CRA dev ports when unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted upload size in megabytes, for the single-document "file"
# field only -- not per-image uploads, which are always capped at 15 MB
# regardless of this setting (main.py). Defaults to 60 when unset (phone
# scans of a multi-page PDF are often 30-60 MB).
MAX_UPLOAD_MB=60

# Folder where uploaded original files are stored, one subfolder per
# <user_id>/<book_id> (main.py). Defaults to an absolute "uploads" folder
# next to main.py when unset.
UPLOAD_DIR=

# Worker threads processing uploaded documents in the background (jobs.py).
# Defaults to 2 when unset.
JOB_WORKERS=2

# Max total seconds a background upload-processing job (jobs.py) will spend
# waiting out Gemini free-tier rate limits during embedding, before giving
# up and marking the book "failed". Much longer than EMBED_MAX_WAIT_SECONDS
# since no user request is blocked on it. Defaults to 1800 (30 minutes) when
# unset.
EMBED_JOB_MAX_WAIT_SECONDS=1800

# Minimum number of real (post-cleanup) characters a PDF page's extracted
# text needs to be treated as "text" (jobs.py). Below this, the page is
# rendered to an image and OCR'd with Gemini vision instead. Defaults to 40
# when unset.
OCR_MIN_CHARS=40

# Caps both how many low-text PDF pages one document may send to OCR, and
# how many images a single multi-image/photo upload may contain (main.py,
# jobs.py) -- OCR is a per-page Gemini vision call, so this bounds cost/time
# on one document. Defaults to 50 when unset.
MAX_OCR_PAGES=50

# Log verbosity (DEBUG/INFO/WARNING/ERROR/CRITICAL). Defaults to INFO when unset.
LOG_LEVEL=INFO

# SQLAlchemy database URL (database.py). Defaults to an absolute
# sqlite:///.../backend/teacher_ai.db path next to database.py when unset
# -- only set this to point at a different file or a different database
# engine entirely (e.g. Postgres) for production.
DATABASE_URL=

# Which AI provider generates answers: "gemini" (default, hosted, needs an
# API key) or "local" (the in-process Flan-T5 model, works fully offline).
LLM_PROVIDER=gemini

# Google Gemini API key (llm.py). Required when LLM_PROVIDER=gemini — the
# app fails to start without it. Get one at https://aistudio.google.com/apikey.
# Never log or commit this value.
GEMINI_API_KEY=

# Gemini model id used for generation (llm.py). Defaults to gemini-3.8-flash
# when unset.
GEMINI_MODEL=gemini-3.8-flash

# Which embedding provider indexes documents and queries: "gemini" (default,
# hosted, free tier, reuses GEMINI_API_KEY above), "voyage" (hosted, needs
# its own API key), or "local" (the in-process MiniLM model, works fully
# offline). Vectors from different providers/dimensions can't be mixed --
# after switching this, run scripts/reembed.py.
EMBEDDING_PROVIDER=gemini

# Gemini embedding model id (embeddings.py). Defaults to gemini-embedding-001
# when unset.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Output vector dimension for Gemini embeddings (embeddings.py). Defaults to
# 768 when unset. Changing this changes active_model_name(), so existing
# pages will need scripts/reembed.py to become searchable again.
GEMINI_EMBED_DIM=768

# How many chunks to send per Gemini embed_content call (embeddings.py).
# Defaults to 50 when unset.
GEMINI_EMBED_BATCH_SIZE=50

# Max total seconds embeddings.py will spend waiting out Gemini free-tier
# rate limits (429s) during one embed_documents() call (document upload),
# before giving up with EmbeddingServiceBusyError (embeddings.py). The free
# tier's embed_content quota resets roughly per minute, so a large upload
# can hit it more than once; each 429 waits for the quota to reset
# (Retry-After if given, otherwise 60s) and then continues with the
# remaining batches, rather than failing on the first rate limit. Defaults
# to 300 when unset.
EMBED_MAX_WAIT_SECONDS=300

# Same as EMBED_MAX_WAIT_SECONDS, but for embed_query() -- used on the
# interactive request path (chat, search, tutor, flashcards, quiz). Kept
# much shorter so a rate-limited question fails fast with a 503 ("AI
# service is busy...") instead of making a user wait minutes. Defaults to
# 15 when unset.
EMBED_QUERY_MAX_WAIT_SECONDS=15

# Voyage AI API key (embeddings.py). Only required when
# EMBEDDING_PROVIDER=voyage — the app fails to start without it in that
# case. Get one at https://dashboard.voyageai.com/. Never log or commit
# this value. Note: a Voyage account without a payment method on file is
# capped at ~10K tokens/minute -- too slow for large uploads.
VOYAGE_API_KEY=

# Voyage embedding model id (embeddings.py). Defaults to voyage-4 when unset.
VOYAGE_MODEL=voyage-4
