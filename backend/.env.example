# Secret key used to sign JWT access tokens (auth.py). Generate a long random string for real deployments.
SECRET_KEY=changeme

# Hugging Face API token. Reserved for future use with Hugging Face-hosted models; not currently read by any module.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Minutes before an issued JWT access token expires (auth.py). Defaults to 60 when unset.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins (main.py). Defaults to the local Vite/CRA dev ports when unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted upload size in megabytes (main.py). Defaults to 25 when unset.
MAX_UPLOAD_MB=25

# Log verbosity (DEBUG/INFO/WARNING/ERROR/CRITICAL). Defaults to INFO when unset.
LOG_LEVEL=INFO

# Which AI provider generates answers: "gemini" (default, hosted, needs an
# API key) or "local" (the in-process Flan-T5 model, works fully offline).
LLM_PROVIDER=gemini

# Google Gemini API key (llm.py). Required when LLM_PROVIDER=gemini — the
# app fails to start without it. Get one at https://aistudio.google.com/apikey.
# Never log or commit this value.
GEMINI_API_KEY=

# Gemini model id used for generation (llm.py). Defaults to gemini-3.8-flash
# when unset.
GEMINI_MODEL=gemini-3.8-flash

# Which embedding provider indexes documents and queries: "gemini" (default,
# hosted, free tier, reuses GEMINI_API_KEY above), "voyage" (hosted, needs
# its own API key), or "local" (the in-process MiniLM model, works fully
# offline). Vectors from different providers/dimensions can't be mixed --
# after switching this, run scripts/reembed.py.
EMBEDDING_PROVIDER=gemini

# Gemini embedding model id (embeddings.py). Defaults to gemini-embedding-001
# when unset.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Output vector dimension for Gemini embeddings (embeddings.py). Defaults to
# 768 when unset. Changing this changes active_model_name(), so existing
# pages will need scripts/reembed.py to become searchable again.
GEMINI_EMBED_DIM=768

# How many chunks to send per Gemini embed_content call (embeddings.py).
# Defaults to 50 when unset.
GEMINI_EMBED_BATCH_SIZE=50

# Max total seconds embeddings.py will spend waiting out Gemini free-tier
# rate limits (429s) during one embed_documents()/embed_query() call, before
# giving up with EmbeddingServiceBusyError (embeddings.py). The free tier's
# embed_content quota resets roughly per minute, so a large upload can hit
# it more than once; each 429 waits for the quota to reset (Retry-After if
# given, otherwise 60s) and then continues with the remaining batches,
# rather than failing on the first rate limit. Defaults to 300 when unset.
EMBED_MAX_WAIT_SECONDS=300

# Voyage AI API key (embeddings.py). Only required when
# EMBEDDING_PROVIDER=voyage — the app fails to start without it in that
# case. Get one at https://dashboard.voyageai.com/. Never log or commit
# this value. Note: a Voyage account without a payment method on file is
# capped at ~10K tokens/minute -- too slow for large uploads.
VOYAGE_API_KEY=

# Voyage embedding model id (embeddings.py). Defaults to voyage-4 when unset.
VOYAGE_MODEL=voyage-4
