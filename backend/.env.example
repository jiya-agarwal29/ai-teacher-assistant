# Secret key used to sign JWT access tokens (auth.py). Generate a long random string for real deployments.
SECRET_KEY=changeme

# Hugging Face API token. Reserved for future use with Hugging Face-hosted models; not currently read by any module.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Minutes before an issued JWT access token expires (auth.py). Defaults to 60 when unset.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins (main.py). Defaults to the local Vite/CRA dev ports when unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted upload size in megabytes (main.py). Defaults to 25 when unset.
MAX_UPLOAD_MB=25
