# Environment files
.env

# Python virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# Node modules
node_modules/
frontend/node_modules/

# Build folders
dist/
build/

# Python cache
__pycache__/
*.pyc

# VS Code
.vscode/

# Local dev database (recreated automatically on first run)
*.db
*.sqlite3

# Uploaded original documents (backend/jobs.py reprocesses from these; not
# source code, and may contain users' own study materials)
backend/uploads/

# Test-run output -- recreated by the test suite itself every time it
# runs (backend/tests/test_api.py's TEST_UPLOAD_DIR / on-disk sqlite
# fallback db), never source code and never meant to be committed.
backend/tests/test_uploads/
backend/tests/*.db

# Zip files
*.zip

