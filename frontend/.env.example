# Base URL of the backend API (services/api.js). Defaults to http://127.0.0.1:8000 when unset.
VITE_API_URL=http://127.0.0.1:8000

# Minutes before a session's JWT expires that the "session is about to
# expire" warning popup (SessionExpiryModal) appears (hooks/AuthProvider.jsx).
# Defaults to 5 when unset.
VITE_SESSION_WARNING_MINUTES=5
